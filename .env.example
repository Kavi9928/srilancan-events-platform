# Copy to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string (mongodb+srv://...).
# Get this from Atlas: Database > Connect > Drivers.
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority"

# Admin login (single hardcoded account, no DB model).
ADMIN_EMAIL="admin@example.com"
# Generate with: node scripts/hash-password.mjs 'your-password'
# IMPORTANT: escape every $ as \$ (e.g. \$2b\$12\$...) — Next's .env loader
# does $VAR-style expansion, which otherwise silently corrupts bcrypt hashes.
ADMIN_PASSWORD_HASH="\$2b\$..."
# Any long random string, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Cloudinary (image hosting for movie posters/banners). Free tier: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (emails new contact-form inquiries). Free tier: https://resend.com
# Without a verified domain, RESEND_FROM_EMAIL must stay "onboarding@resend.dev"
# and the recipient must be the address your Resend account was signed up with.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
# Inbox that receives contact-form notifications. Kept separate from
# ADMIN_EMAIL, which is the admin *login* identity. Falls back to ADMIN_EMAIL
# when blank. Sending anywhere other than the Resend account owner's own
# address requires a verified domain at resend.com/domains.
CONTACT_NOTIFICATION_EMAIL=""

# Public origin, used for metadataBase, canonical URLs, the sitemap and
# robots.txt. Defaults to https://srilancanevents.ca when unset — set it
# explicitly on preview deployments so they do not advertise production URLs.
NEXT_PUBLIC_SITE_URL="https://srilancanevents.ca"
