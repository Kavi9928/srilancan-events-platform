generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum MovieStatus {
  NOW_SHOWING
  COMING_SOON
  ARCHIVED
}

model Movie {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  slug            String      @unique
  description     String
  genres          String[]
  posterUrl       String
  bannerUrl       String
  trailerUrl      String?
  durationMinutes Int
  releaseDate     DateTime
  status          MovieStatus @default(COMING_SOON)
  ticketUrl       String?
  rating          Float?
  screenings      Screening[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status])
}

model Screening {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  startTime DateTime
  venue     String?
  ticketUrl String?
  movieId   String   @db.ObjectId
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([movieId])
  @@index([startTime])
}
